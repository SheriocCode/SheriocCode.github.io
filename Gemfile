source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'webrick', '~> 1.8'
end

# Windows 上没有系统时区数据，Jekyll 需要 tzinfo-data 才能启动
gem 'tzinfo-data', platforms: [:windows, :jruby]

gem 'github-pages'
gem 'connection_pool', '2.5.0'
